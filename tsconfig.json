{
  "compilerOptions": {
    "target": "es2015", // Added line
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "checkJs": false, 
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "app/**/*.d.ts",
    "app/src/services/*.js", "../archive-v1-bloom/app.tsx", "../archive-v1-bloom/TopBar.tsx", "../archive-v1-bloom/GenerateAIForm.tsx", 
  ],
  "exclude": [
    "node_modules",
    "Archived",
    "Archived/**/*",
  ]
}
