import weaviate from 'weaviate-ts-client';

async function deleteTextEmbeddingClass() {
  const client = weaviate.client({
    scheme: 'http',
    host: 'localhost:8080',
  });

  try {
    await client.schema.classDeleter()
      .withClassName('TextEmbedding')
      .do();
    console.log("Successfully deleted TextEmbedding class.");
  } catch (error) {
    console.error("Error deleting TextEmbedding class:", error);
  }
}

deleteTextEmbeddingClass();
